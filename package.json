{
  "name": "@nostr-org-tr/nostr-event-dom",
  "version": "0.1.0",
  "description": "A lightweight web component for rendering Nostr events with CSS customizability",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/nostr-event.umd.cjs",
  "module": "./dist/nostr-event.js",
  "unpkg": "./dist/nostr-event.global.js",
  "jsdelivr": "./dist/nostr-event.global.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nostr-event.js",
      "require": "./dist/nostr-event.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/nostr-event.global.js",
    "./src/nostr-event.ts",
    "./src/index.ts"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nostr-org-tr/nostr-event-dom.git"
  },
  "bugs": {
    "url": "https://github.com/Nostr-org-tr/nostr-event-dom/issues"
  },
  "homepage": "https://github.com/Nostr-org-tr/nostr-event-dom#readme",
  "keywords": [
    "nostr",
    "web-component",
    "custom-elements",
    "decentralized",
    "nip-19",
    "nip-21",
    "nip-23",
    "nip-52",
    "nip-68",
    "nip-71"
  ],
  "author": "nostr.org.tr community <https://github.com/Nostr-org-tr>",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "nostr-tools": "^2.10.4"
  }
}
